# --- Passwall Watchdog - Configuration Template ---

# [Connectivity Check]
# IP used to verify upstream internet connection (Default: 8.8.8.8)
PING_TARGET="8.8.8.8"

# [Proxy Health Check]
# Website to verify if proxy/tunnel is working (Default: https://www.youtube.com)
# Choose a site that is normally blocked in your region to verify bypass status.
TEST_URL="https://www.youtube.com"

# [Hardware - Auto-detected on first run]
LED_RED="/sys/class/leds/red:status/brightness"
LED_GREEN="/sys/class/leds/green:status/brightness"
LED_BLUE="/sys/class/leds/blue:status/brightness"

# [Backup System]
# Recommended to keep enabled to prevent configuration loss during updates.
ENABLE_BACKUP="1"
