#!/bin/sh /etc/rc.common

START=99
STOP=10
USE_PROCD=1

SCRIPT="/usr/bin/Passwall_watchdog.sh"
PID_FILE="/tmp/passwall_watchdog.pid"

start_service() {
    procd_open_instance
    procd_set_param command "$SCRIPT" boot
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

stop_service() {
    # Remove PID file to signal the watchdog loop to exit cleanly
    rm -f "$PID_FILE"
    # Give the loop one cycle to notice before we force kill
    sleep 2
    killall -q Passwall_watchdog.sh 2>/dev/null
    killall -9 xray sing-box ss-local ssr-local 2>/dev/null
}

restart() {
    stop_service
    sleep 1
    start_service
}
